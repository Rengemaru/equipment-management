# 環境変数の雛形。コピーして .env を作る。
#   cp .env.example .env          (macOS)
#   Copy-Item .env.example .env   (Windows)
#
# .env はコミットしない（.gitignore 済み）。
# 開発コンテナは .env が無くても起動する。

# ---- サーバ ----

# 待ち受けポート。compose.dev.yaml のポート公開と揃えること
PORT=8080

# QRコードに埋め込むURLの土台。末尾にスラッシュを付けない。
#   QRの中身は {HOST_URL}/i/{code} になる
# 本番ではここを短いホスト名にする。長いとQRのセル数が増え、
# 小さいラベルに貼れなくなる。ラベルは貼り替えられないため後から変更できない。
HOST_URL=http://localhost:8080

# ---- データ ----

# SQLite の置き場所。コンテナ内の /data は名前付きボリューム。
# ホストのバインドマウントに置かないこと（WALのロックが壊れる）
DB_PATH=/data/app.db

# 備品写真の保存先。DBには入れずパスだけ持つ
UPLOAD_DIR=/uploads

# ---- 認証 ----

# セッションCookieの署名鍵。十分に長いランダム文字列にする。
# 本番では必ず変更する。変更するとログイン中のセッションは全て無効になる。
# 生成例:
#   openssl rand -base64 48
#   docker compose -f compose.dev.yaml exec dev openssl rand -base64 48
SESSION_SECRET=change-me-this-is-only-for-local-development

# Cookie に Secure 属性を付けるか。
# HTTPS でないと Secure Cookie はブラウザに保存されず、ログインが無限ループする。
# 本番（HTTPS）では true。HTTP で運用する場合のみ false にする。
COOKIE_SECURE=false

# ---- メール（M2から使う。M1では不要） ----
# 認証はメールに依存しないため、未設定でもログインは動く。
# 未設定の場合、メール通知はスキップされる。
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
