# === ビルド成果物 ===
/bin/
/dist/

# フロントのビルド成果物。中身はコミットしないが、__ディレクトリは残す。__
# Go が go:embed で取り込むため、空でも存在しないと `go build` が落ちる
# （「contains no embeddable files」）。.gitkeep は npm run build の
# postbuild で作り直す（vite build が dist を空にするため）。
web/dist/*
!web/dist/.gitkeep
*.exe
*.exe~
# コンテナ内で `go build` すると拡張子の無い Linux バイナリが
# リポジトリ直下に落ちる。cmd/server/ は追跡対象なので先頭 / で限定する。
/server

# === データ（絶対にコミットしない） ===
# SQLite本体とWAL/SHM。個人情報と貸出履歴が入る
/data/
*.db
*.db-wal
*.db-shm

# 備品写真のアップロード先
/uploads/

# === 秘密情報 ===
.env
.env.*
!.env.example

# === 依存 ===
node_modules/

# === エディタ / OS ===
.DS_Store
Thumbs.db
.vscode/
.idea/

# === Go ===
*.test
*.out
/vendor/
